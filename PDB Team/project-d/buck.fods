     <table:table-cell table:style-name="ce34" office:value-type="string" calcext:value-type="string">
      <text:p>Peak-to-peak ripple current:</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce53" office:value-type="string" calcext:value-type="string"><text:p>I<text:span text:style-name="T4">ppRIPPLE</text:span><text:span text:style-name="T5"> =</text:span></text:p>
     </table:table-cell>
