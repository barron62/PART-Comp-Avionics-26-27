     <table:table-cell table:style-name="ce28" office:value-type="string" calcext:value-type="string">
      <text:p>Peak switch current:</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce46" office:value-type="string" calcext:value-type="string"><text:p>I<text:span text:style-name="T4">PEAK</text:span><text:span text:style-name="T5"> =</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce68" table:formula="of:=Iout+Imin" office:value-type="float" office:value="2.2" calcext:value-type="float">
      <text:p>2.2</text:p>
     </table:table-cell>
