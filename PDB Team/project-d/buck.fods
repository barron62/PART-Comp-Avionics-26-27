    <table:table-row table:style-name="ro5">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce27" office:value-type="string" calcext:value-type="string">
      <text:p>Average rectified output current:</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce45" office:value-type="string" calcext:value-type="string"><text:p>I<text:span text:style-name="T4">AVE</text:span><text:span text:style-name="T5"> = </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce70" table:formula="of:=Iout*(1-duty)" office:value-type="float" office:value="1.43298969072165" calcext:value-type="float">
      <text:p>1.433</text:p>
